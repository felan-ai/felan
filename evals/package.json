{
  "name": "@felan-ai/felan-extension-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "list": "node scripts/source-cli.mjs list",
    "run": "node scripts/source-cli.mjs run",
    "view": "harness-evals view --config felan-extension-evals.yaml --latest --open",
