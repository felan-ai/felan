+export function getPersistableExtensionConfig(
+  definitions: readonly ExtensionConfigDefinition[],
+  overrides: readonly ExtensionConfigOverride[] = [],
+  target: 'user' | 'project' = 'user',
+): ReadonlyMap<string, Readonly<Record<string, ExtensionConfigValue>>> {
+  const resolved = resolveExtensionConfigs(definitions, overrides);
+  const definitionsById = definitionMap(definitions);
+  const persistable = new Map<string, Readonly<Record<string, ExtensionConfigValue>>>();
+  for (const [id, values] of resolved) {
+    const definition = definitionsById.get(id)!;
+    const kept: Record<string, ExtensionConfigValue> = {};
+    for (const [name, value] of Object.entries(values)) {
+      if (definition.fields[name]?.scope === target) kept[name] = value;
+    }
+    persistable.set(id, Object.freeze(kept));
+  }
+  return persistable;
+}
