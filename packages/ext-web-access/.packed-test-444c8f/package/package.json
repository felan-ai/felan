{
  "name": "@felan-ai/ext-web-access",
  "version": "0.12.0",
  "description": "Secure bounded web search and content access for Felan",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felan-ai/felan.git",
    "directory": "packages/ext-web-access"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.16.11",
    "turndown": "7.2.0",
    "typebox": "1.1.38",
    "undici": "8.11.2"
  },
  "peerDependencies": {
    "@felan-ai/agent-core": "^0.14.0"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6",
    "@felan-ai/agent-core": "0.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm run test:dist",
    "test:dist": "pnpm run build && vitest run --config test/vitest.dist.config.ts"
  }
}