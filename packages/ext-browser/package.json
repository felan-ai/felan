{
  "name": "@felan-ai/ext-browser",
  "version": "0.12.0",
  "description": "Portable agent-browser tool integration for Felan",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felan-ai/felan.git",
    "directory": "packages/ext-browser"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@felan-ai/agent-core": "catalog:agent-core"
  },
  "devDependencies": {
    "@felan-ai/agent-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
