{
  "name": "@felan-ai/ext-powerline",
  "version": "0.13.1",
  "description": "Terminal powerline extension for Felan",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felan-ai/felan.git",
    "directory": "packages/ext-powerline"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "catalog:pi"
  },
  "peerDependencies": {
    "@felan-ai/agent-core": "catalog:agent-core"
  },
  "devDependencies": {
    "@felan-ai/agent-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
