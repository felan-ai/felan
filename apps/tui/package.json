{
  "name": "@felan-ai/felan",
  "version": "0.1.0-alpha.2",
  "description": "Local Felan terminal agent",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felan-ai/felan.git",
    "directory": "apps/tui"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "bin": {
    "felan": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@felan-ai/agent-core": "workspace:*",
    "@felan-ai/ext-context": "workspace:*",
    "@felan-ai/ext-powerline": "workspace:*",
    "@felan-ai/ext-prewalk": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
